---
import { config } from '../../config';
import ObfuscatedEmail from '../ui/ObfuscatedEmail.astro';
import PartnerLogo from '../ui/PartnerLogo.astro';
import { getMediaPartners, getSponsorGroups } from '../../lib/partners';

// Sponsors and media partners: the technical partners need the explanatory copy
// /partenaires gives them, which does not fit a logo strip.
const sponsorGroups = await getSponsorGroups();
const mediaPartners = await getMediaPartners();

// Same centred rows and tapering as /partenaires, one notch smaller — this is a
// preview. The tier is named here too: sponsors buy the tier, and a 14px versus
// 12px difference in logo height is not something a visitor can read as "Or
// rather than Argent". Labels are muted grey, not the page's orange, so they
// stay subordinate to the section heading.
const tierLayout: Record<string, { logoSize: string; width: string }> = {
  platine: { logoSize: 'max-h-16', width: 'w-[calc(50%-0.5rem)] sm:w-52' },
  or: { logoSize: 'max-h-14', width: 'w-[calc(50%-0.5rem)] sm:w-44' },
  argent: { logoSize: 'max-h-12', width: 'w-[calc(50%-0.5rem)] sm:w-40' },
  bronze: { logoSize: 'max-h-10', width: 'w-[calc(50%-0.5rem)] sm:w-36' },
};
---

<section class="py-16 sm:py-24 bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-cdl-blue mb-4">
        Ils soutiennent l'événement
      </h2>
      <p class="text-lg text-cdl-gray">
        Le Capitole du Libre est rendu possible grâce à nos partenaires.
      </p>
    </div>

    {sponsorGroups.length > 0 && (
      <div class="space-y-8">
        {sponsorGroups.map((tier) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-cdl-gray mb-3 text-center">{tier.label}</h3>
            <div class="flex flex-wrap justify-center gap-4 sm:gap-6">
              {tier.partners.map((partner) => (
                <PartnerLogo
                  partner={partner}
                  logoSize={tierLayout[tier.key].logoSize}
                  padding="p-4 sm:p-5"
                  class={tierLayout[tier.key].width}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    {mediaPartners.length > 0 && (
      <div class="mt-8">
        {/* Spelt out rather than shortened to "Média": the row sits under the
            Platine/Or/Argent/Bronze labels, and a one-word label there would
            read as one more rung of the sponsor ladder. */}
        <h3 class="text-xs font-semibold uppercase tracking-wider text-cdl-gray mb-3 text-center">Partenaires média</h3>
        <div class="flex flex-wrap justify-center gap-4 sm:gap-6">
          {mediaPartners.map((partner) => (
            <PartnerLogo
              partner={partner}
              logoSize="max-h-12"
              padding="p-4 sm:p-5"
              class="w-[calc(50%-0.5rem)] sm:w-40"
            />
          ))}
        </div>
      </div>
    )}

    <div class="text-center mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/partenaires/"
        class="inline-flex items-center gap-2 text-cdl-orange hover:text-cdl-orange-light font-medium transition-colors"
      >
        Voir tous les partenaires
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <span class="text-cdl-gray-light hidden sm:inline">|</span>
      <a
        href={config.links.partnersBrochure}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-cdl-blue-light hover:text-cdl-blue font-medium transition-colors"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Plaquette partenaires
      </a>
      <span class="text-cdl-gray-light hidden sm:inline">|</span>
      <ObfuscatedEmail
        subject={`Partenariat — Capitole du Libre ${config.edition.year}`}
        class="inline-flex items-center gap-2 text-cdl-blue-light hover:text-cdl-blue font-medium transition-colors"
      >
        Devenir partenaire
      </ObfuscatedEmail>
    </div>
  </div>
</section>
