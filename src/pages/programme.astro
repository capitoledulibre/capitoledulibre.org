---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import TicketCta from '../components/ui/TicketCta.astro';
import CampusPlan from '../components/ui/CampusPlan.astro';
import { config } from '../config';
import { breadcrumb, eventNode, sessionEvents } from '../lib/jsonld';
import { getTalks, type FormattedTalk } from '../lib/pretalx';
import { parseRoom } from '../lib/rooms';
import { formatDayLabel, formatTalkTime, talkPath } from '../lib/talks';

let talks: FormattedTalk[] = [];
let fetchError = false;

try {
  talks = await getTalks();
  talks.sort((a, b) => {
    if (!a.start || !b.start) return 0;
    return new Date(a.start).getTime() - new Date(b.start).getTime();
  });
} catch (e) {
  // getTalks() already falls back to a stale cache, so reaching here means we
  // have no schedule data at all. Swallowing that in a production build would
  // deploy /programme stripped of its schedule while the build still exits 0,
  // so fail loudly instead. Dev keeps rendering the empty state, and
  // PRETALX_ALLOW_EMPTY=1 unblocks a deliberate build without Pretalx.
  const allowEmpty = import.meta.env.DEV || process.env.PRETALX_ALLOW_EMPTY === '1';
  if (!allowEmpty) throw e;
  console.error('[programme] Pretalx unavailable, rendering empty state:', e);
  fetchError = true;
}

const days = [...new Set(talks.map((t) => t.start?.slice(0, 10)).filter(Boolean))] as string[];
const tracks = [...new Set(talks.map((t) => t.track).filter(Boolean))].sort() as string[];
const types = [...new Set(talks.map((t) => t.type).filter(Boolean))].sort() as string[];

/*
 * Every displayed time is pinned to Europe/Paris by the helpers in lib/talks.
 * These three used to format in the build machine's timezone, which silently
 * worked only because the deploy runs from Toulouse: built with TZ=UTC, this
 * page showed 10:00 for the talk its own session page showed as 11:00.
 */
const formatTime = formatTalkTime;

const formatDay = (dateStr: string) =>
  formatDayLabel(dateStr, { weekday: 'long', day: 'numeric', month: 'long' });

const formatDayShort = (dateStr: string) => formatDayLabel(dateStr, { weekday: 'long' });

// Group talks by day then by time slot
type TimeSlot = { time: string; timeEnd: string; talks: FormattedTalk[] };
type DaySchedule = { day: string; slots: TimeSlot[] };

const schedule: DaySchedule[] = days.map((day) => {
  const dayTalks = talks.filter((t) => t.start?.startsWith(day));
  const slotMap = new Map<string, FormattedTalk[]>();

  for (const talk of dayTalks) {
    const key = talk.start!;
    if (!slotMap.has(key)) slotMap.set(key, []);
    slotMap.get(key)!.push(talk);
  }

  const slots = [...slotMap.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([time, slotTalks]) => ({
      time,
      timeEnd: slotTalks.reduce((latest, t) => {
        if (!t.end) return latest;
        return t.end > latest ? t.end : latest;
      }, ''),
      talks: slotTalks.sort((a, b) => (a.room ?? '').localeCompare(b.room ?? '')),
    }));

  return { day, slots };
});

// Pass event slug to client for scoped localStorage keys
const eventSlug = config.pretalx.eventSlug;
// The canonical page for a session is now this site's own, not the Pretalx
// one: it is what the share button hands out and what carries the per-talk
// social card. See src/pages/programme/talk/[code]/index.astro.
const talkUrl = (code: string) => new URL(talkPath(code), Astro.site).href;

/**
 * True once the Pretalx event matches the edition the site advertises. Until
 * then the page falls back to the previous programme, which must not be
 * described as this edition's schedule in structured data.
 */
const isCurrentEdition = eventSlug === `cdl-${config.edition.year}`;

const scheduleJsonLd =
  isCurrentEdition && talks.length > 0
    ? eventNode({
        subEvents: sessionEvents(talks, talkUrl, { withDescription: false }),
        performers: [...new Map(
          talks.flatMap((t) => t.speakers).map((s) => [s.name, { name: s.name }]),
        ).values()],
      })
    : null;

/**
 * Client payload for the modal, search, .ics export and the "En ce moment"
 * panel. Only what the client reads up front: abstracts and speaker bios live
 * in /programme/details.json, fetched on first need — they were two thirds of
 * this payload. Room details are keyed by room rather than repeated per talk.
 */
const roomsPayload = Object.fromEntries(
  [...new Set(talks.map((t) => t.room).filter(Boolean))].map((room) => [room, parseRoom(room!)]),
);

const talksPayload = talks.map((t) => ({
  code: t.code,
  title: t.title,
  type: t.type,
  track: t.track,
  duration: t.duration,
  room: t.room,
  start: t.start,
  end: t.end,
  startFormatted: formatTime(t.start),
  endFormatted: formatTime(t.end),
  audience: t.audience,
  speakers: t.speakers.map((s) => ({
    name: s.name,
    avatar: s.avatar,
  })),
  resources: t.resources,
}));

// Escaping `<` keeps a description containing "</script>" from closing the tag.
const talksJson = JSON.stringify({ talks: talksPayload, rooms: roomsPayload }).replace(
  /</g,
  '\\u003c',
);
---

<BaseLayout title="Programme" description="Découvrez le programme complet du Capitole du Libre : conférences, ateliers, keynotes.">
  <JsonLd slot="head" data={breadcrumb([{ name: 'Programme', path: '/programme/' }])} />
  {scheduleJsonLd && <JsonLd slot="head" data={scheduleJsonLd} />}
  <PageHeader title="Programme" description="Conférences, ateliers et keynotes sur deux jours." />

  <section class="py-8 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {fetchError || talks.length === 0 ? (
        <div class="text-center py-20">
          <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-cdl-orange/10 mb-6">
            <svg class="h-8 w-8 text-cdl-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-cdl-blue mb-4">Programme à venir</h2>
          <p class="text-cdl-gray max-w-md mx-auto mb-8">
            Le programme sera publié prochainement. En attendant, vous pouvez proposer un sujet !
          </p>
          <a
            href={config.cfp.url}
            class="inline-flex items-center gap-2 px-6 py-3 text-white bg-cdl-orange hover:bg-cdl-orange-light rounded-lg transition-colors font-medium"
          >
            Proposer un sujet
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      ) : (
        <>
          {/* Barre de filtres sticky */}
          <div id="filter-bar" class="sticky top-16 z-30 bg-cdl-bg/95 dark:bg-gray-900/95 backdrop-blur-sm -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 py-4 border-b border-cdl-gray-light mb-8">
            <div class="flex flex-wrap items-center gap-3">
              {/* Onglets jour */}
              <div class="flex gap-1 p-1 bg-cdl-gray-light rounded-lg" role="tablist" aria-label="Jour">
                {days.map((day, i) => (
                  <button
                    role="tab"
                    aria-selected={i === 0 ? 'true' : 'false'}
                    data-tab-day={day}
                    class:list={[
                      'day-tab px-4 py-2 text-sm font-medium rounded-md transition-colors capitalize',
                      i === 0 ? 'bg-white dark:bg-gray-800 text-cdl-orange shadow-sm' : 'text-cdl-gray hover:text-cdl-orange',
                    ]}
                  >
                    {formatDayShort(day)}
                  </button>
                ))}
              </div>

              {/* Recherche */}
              <div class="relative flex-1 min-w-[200px] max-w-sm">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-cdl-gray/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input
                  id="search"
                  type="search"
                  placeholder="Rechercher un talk, un speaker..."
                  class="w-full pl-10 pr-4 py-2 text-sm border border-cdl-gray-light rounded-lg bg-white dark:bg-gray-800 text-cdl-gray focus:outline-2 focus:outline-cdl-orange placeholder:text-cdl-gray/80"
                />
              </div>

              {/* Filtres secondaires */}
              {tracks.length > 1 && (
                <select id="filter-track" class="px-3 py-2 text-sm border border-cdl-gray-light rounded-lg bg-white dark:bg-gray-800 text-cdl-gray focus:outline-2 focus:outline-cdl-orange">
                  <option value="all">Toutes les tracks</option>
                  {tracks.map((track) => (
                    <option value={track}>{track}</option>
                  ))}
                </select>
              )}
              {types.length > 1 && (
                <select id="filter-type" class="px-3 py-2 text-sm border border-cdl-gray-light rounded-lg bg-white dark:bg-gray-800 text-cdl-gray focus:outline-2 focus:outline-cdl-orange">
                  <option value="all">Tous les formats</option>
                  {types.map((type) => (
                    <option value={type}>{type}</option>
                  ))}
                </select>
              )}

              {/* Toggle favoris */}
              <button
                id="filter-favs"
                class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium border border-cdl-gray-light rounded-lg bg-white dark:bg-gray-800 text-cdl-gray hover:border-cdl-orange/30 hover:text-cdl-orange transition-colors"
                aria-pressed="false"
              >
                <svg class="h-4 w-4 fav-icon-off" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <svg class="h-4 w-4 fav-icon-on hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                Mes favoris
                <span id="fav-count" class="hidden text-xs bg-cdl-orange text-white rounded-full px-1.5 py-0.5 leading-none"></span>
              </button>

              {/* Export .ics */}
              <button
                id="export-favs"
                class="hidden inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium border border-cdl-gray-light rounded-lg bg-white dark:bg-gray-800 text-cdl-gray hover:border-cdl-orange/30 hover:text-cdl-orange transition-colors"
                title="Télécharger mes favoris au format calendrier (.ics)"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
                </svg>
                <span class="hidden sm:inline">Exporter</span>
                <span class="text-[11px] text-cdl-gray/85">.ics</span>
              </button>
            </div>
          </div>

          {/* Compteur résultats — annoncé aux lecteurs d'écran quand les filtres changent */}
          <p
            id="results-count"
            role="status"
            aria-live="polite"
            class="text-sm text-cdl-gray mb-6"
          ></p>

          {/* Offline availability — filled by the script, see updateOfflineStatus() */}
          <p id="offline-status" role="status" class="hidden -mt-3 mb-6 text-xs text-cdl-gray"></p>

          {/* En ce moment — filled and revealed by the script during the event only */}
          <section id="maintenant" class="hidden mb-10" aria-labelledby="now-title">
            <div class="rounded-2xl border border-red-600/30 bg-white dark:bg-gray-800 p-4 sm:p-6 shadow-sm">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4">
                <h2 id="now-title" class="inline-flex items-center gap-2 text-xl font-bold text-cdl-blue">
                  <span class="h-2.5 w-2.5 rounded-full bg-red-600 animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
                  En ce moment
                </h2>
                <p id="now-clock" class="text-xs text-cdl-gray"></p>
              </div>
              <ul id="now-current" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></ul>
              <p id="now-current-empty" class="hidden text-sm text-cdl-gray">
                Aucune session en cours : c'est le moment de faire un tour au <a href="/village-associatif/" class="text-cdl-orange hover:underline">village associatif</a> !
              </p>
              <div id="now-next-block" class="hidden">
                <h3 class="mt-6 mb-3 text-sm font-semibold text-cdl-blue uppercase tracking-wider">À suivre</h3>
                <ul id="now-next" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></ul>
              </div>
            </div>
          </section>

          {/* Timeline par jour */}
          {schedule.map((daySchedule, dayIdx) => (
            <div
              data-day-panel={daySchedule.day}
              class:list={['day-panel', dayIdx > 0 && 'hidden']}
            >
              <h2 class="text-2xl font-bold text-cdl-blue mb-8 capitalize">{formatDay(daySchedule.day)}</h2>

              <div class="relative">
                {/* Ligne verticale timeline */}
                <div class="absolute left-[39px] sm:left-[55px] top-0 bottom-0 w-0.5 bg-cdl-gray-light" aria-hidden="true"></div>

                <div class="space-y-10">
                  {daySchedule.slots.map((slot) => (
                    <div class="time-slot relative" data-slot-time={slot.time} data-slot-end={slot.timeEnd}>
                      {/* Marqueur horaire */}
                      <div class="flex items-start gap-4 sm:gap-6">
                        <div class="relative z-10 flex-shrink-0 w-[78px] sm:w-[110px]" data-slot-marker>
                          <div class="inline-flex items-center px-3 py-1.5 bg-cdl-orange text-white text-sm font-bold rounded-lg shadow-sm">
                            {formatTime(slot.time)}
                          </div>
                        </div>

                        {/* Talks du créneau */}
                        <div class="flex-1 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 pb-2">
                          {slot.talks.map((talk) => (
                            <div class="relative">
                            <a
                              href={talkPath(talk.code)}
                              class="talk-card block text-left p-4 pr-10 w-full rounded-xl border border-cdl-gray-light hover:border-cdl-orange/40 hover:shadow-md transition-all bg-white dark:bg-gray-800 group"
                              data-code={talk.code}
                              data-track={talk.track}
                              data-type={talk.type}
                            >
                              {/* En-tête compact */}
                              <div class="flex items-center gap-1.5 mb-2 flex-wrap">
                                {talk.room && (() => {
                                  const ri = parseRoom(talk.room);
                                  return (
                                    <span class="text-[11px] font-medium text-cdl-blue-light bg-cdl-blue/5 px-2 py-0.5 rounded" title={ri?.label}>
                                      {talk.room}
                                    </span>
                                  );
                                })()}
                                <span class="text-[11px] text-cdl-gray bg-cdl-gray-light/70 px-2 py-0.5 rounded">
                                  {talk.duration} min
                                </span>
                                {talk.type && (
                                  <span class:list={[
                                    'text-[11px] font-medium px-2 py-0.5 rounded',
                                    talk.type.toLowerCase().includes('atelier')
                                      ? 'bg-cdl-gold/20 text-cdl-orange-dark'
                                      : talk.type.toLowerCase().includes('keynote')
                                        ? 'bg-cdl-orange/10 text-cdl-orange'
                                        : 'bg-cdl-gray-light/70 text-cdl-gray',
                                  ]}>
                                    {talk.type}
                                  </span>
                                )}
                              </div>

                              {/* Titre */}
                              <h3 class="font-bold text-cdl-blue text-sm leading-snug mb-2 group-hover:text-cdl-orange transition-colors">
                                {talk.title}
                              </h3>

                              {/* Speakers */}
                              {talk.speakers.length > 0 && (
                                <div class="flex items-center gap-1.5 flex-wrap">
                                  {talk.speakers.map((speaker) => (
                                    <span class="inline-flex items-center gap-1 text-xs text-cdl-gray">
                                      {speaker.avatar ? (
                                        <img src={speaker.avatar} alt="" class="h-4 w-4 rounded-full object-cover" loading="lazy" width="16" height="16" />
                                      ) : (
                                        <span class="h-4 w-4 rounded-full bg-cdl-orange/10 flex items-center justify-center text-[9px] font-bold text-cdl-orange">{speaker.name.charAt(0)}</span>
                                      )}
                                      {speaker.name}
                                    </span>
                                  ))}
                                </div>
                              )}

                              {/* Public visé — free text from the CfP, so clamped to one line */}
                              {talk.audience && (
                                <p class="mt-2 text-[11px] text-cdl-gray/90 line-clamp-1" title={talk.audience}>
                                  <span class="font-medium">Public :</span> {talk.audience}
                                </p>
                              )}

                              {/* Track badge */}
                              {talk.track && (
                                <div class="mt-2 pt-2 border-t border-cdl-gray-light/50">
                                  <span class="text-[11px] font-medium text-cdl-orange">
                                    {talk.track}
                                  </span>
                                </div>
                              )}
                            </a>
                            <button
                              type="button"
                              class="fav-btn absolute top-3 right-3 p-1.5 rounded-full hover:bg-cdl-orange/5 transition-colors z-10"
                              data-fav={talk.code}
                              aria-label="Ajouter aux favoris"
                            >
                              <svg class="fav-off h-5 w-5 text-cdl-gray-light hover:text-cdl-orange transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                              </svg>
                              <svg class="fav-on h-5 w-5 text-cdl-orange hidden" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                              </svg>
                            </button>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}

          {/* Message quand aucun résultat */}
          <div id="no-results" class="hidden text-center py-16">
            <p class="text-cdl-gray text-lg">Aucun résultat pour cette recherche.</p>
            <button id="reset-filters" class="mt-4 text-cdl-orange hover:text-cdl-orange-light font-medium transition-colors">
              Réinitialiser les filtres
            </button>
          </div>
        </>
      )}
    </div>
  </section>

  <TicketCta
    title="Ce programme vous inspire ?"
    description="L'entrée est libre et gratuite, mais l'inscription nous aide à préparer au mieux votre venue."
  />

  {/* Modal */}
  <dialog
    id="talk-modal"
    aria-labelledby="modal-title"
    class="fixed inset-0 m-auto w-full max-w-2xl max-h-[85vh] rounded-2xl border-none shadow-2xl p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm dark:bg-gray-800"
  >
    <div class="relative overflow-y-auto max-h-[85vh]">
      {/* Header modal */}
      <div class="sticky top-0 bg-white dark:bg-gray-800 z-10 flex items-center justify-between px-6 py-4 border-b border-cdl-gray-light">
        <div class="flex items-center gap-2 min-w-0" id="modal-badges"></div>
        <div class="flex items-center gap-1 flex-shrink-0">
          <button
            id="modal-share"
            type="button"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-cdl-gray hover:text-cdl-orange rounded-lg hover:bg-cdl-orange/5 transition-colors"
            aria-label="Partager cette session"
          >
            <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342a3 3 0 100-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684zm0-12a3 3 0 105.368-2.684 3 3 0 00-5.368 2.684z" />
            </svg>
            <span id="modal-share-label" class="hidden sm:inline">Partager</span>
          </button>
          {/* The label above is hidden below `sm`, so the confirmation gets its
              own always-rendered live region rather than relying on it. */}
          <span id="modal-share-status" role="status" aria-live="polite" class="sr-only"></span>
          <button id="modal-close" class="p-1.5 text-cdl-gray hover:text-cdl-orange rounded-lg hover:bg-cdl-orange/5 transition-colors" aria-label="Fermer">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      {/* Contenu modal */}
      <div class="px-6 py-6">
        <div class="flex items-start gap-3 mb-4">
          <h2 id="modal-title" class="text-xl sm:text-2xl font-bold text-cdl-blue flex-1"></h2>
          <button
            id="modal-fav"
            type="button"
            class="flex-shrink-0 p-2 rounded-full hover:bg-cdl-orange/5 transition-colors"
            aria-label="Ajouter aux favoris"
          >
            <svg class="modal-fav-off h-6 w-6 text-cdl-gray-light hover:text-cdl-orange transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <svg class="modal-fav-on h-6 w-6 text-cdl-orange hidden" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </button>
        </div>

        <div id="modal-meta" class="flex flex-wrap items-center gap-3 mb-6 text-sm text-cdl-gray"></div>

        <div id="modal-room-info" class="hidden mb-6">
          <div id="modal-room-text" class="mb-3"></div>
          <div id="modal-room-plan" class="hidden sm:block"></div>
        </div>

        <div id="modal-audience" class="hidden mb-6">
          <h3 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-2">Public visé</h3>
          <p id="modal-audience-text" class="text-sm text-cdl-gray leading-relaxed"></p>
        </div>

        <div id="modal-speakers" class="mb-6"></div>

        <div id="modal-resources" class="hidden mb-6"></div>

        <div id="modal-desc-section">
          <h3 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">Description</h3>
          <div id="modal-description" class="prose prose-sm max-w-none text-cdl-gray leading-relaxed"></div>
        </div>
      </div>
    </div>
  </dialog>

  {/* Static plan cloned into the talk modal to highlight the room's building */}
  <template id="campus-plan-template">
    <CampusPlan interactive={false} showLegend={false} />
  </template>
</BaseLayout>

<style>
  dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(4px);
  }
  dialog[open] {
    animation: modal-in 0.2s ease-out;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .time-slot.is-current .talk-card {
    border-color: rgb(220 38 38 / 0.5);
  }
  .time-slot.is-next .talk-card {
    border-color: rgb(26 54 93 / 0.4);
  }
</style>

{/*
  The payload rides in a JSON island rather than `define:vars`: define:vars
  forces the script inline (so Astro never compiles its TypeScript) and
  re-escapes the whole JSON as a JS string literal, inflating it.
*/}
<script
  type="application/json"
  id="talks-data"
  data-event-slug={eventSlug}
  data-site-url={Astro.site}
  data-venue={config.venue.name}
  data-built-at={new Date().toISOString()}
  set:html={talksJson}
/>

<script>
  const dataEl = document.getElementById('talks-data');
  const payload = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
  const talks = payload.talks || [];
  /** Room name → parsed room details (building, floor, directions). */
  const rooms = payload.rooms || {};
  const eventSlug = dataEl?.dataset.eventSlug || '';
  // Canonical origin, so a shared link points at the published site even when
  // the page is being read from a preview host.
  const siteUrl = dataEl?.dataset.siteUrl || location.origin;
  const venueName = dataEl?.dataset.venue || '';
  const talksMap = new Map(talks.map((t) => [t.code, t]));

  /** Site-relative path of a session's own page. Mirrors src/lib/talks.ts. */
  function talkPath(code) {
    return `/programme/talk/${code}/`;
  }

  /** The URL to hand out for a session. */
  function talkUrl(code) {
    return new URL(talkPath(code), siteUrl).href;
  }

  /**
   * What to put in the address bar for a session, keeping whatever query string
   * is already there — `?now=` is a debug override the schedule reads on every
   * refresh, and dropping it mid-session would silently un-fake the clock.
   */
  function historyHref(path) {
    return path + location.search;
  }

  /** Strips tags from pre-rendered markdown, for search and .ics text. */
  function toPlainText(html) {
    if (!html) return '';
    const el = document.createElement('div');
    el.innerHTML = html;
    return (el.textContent || '').replace(/\s+/g, ' ').trim();
  }

  // ── Long-form text (abstracts, bios), fetched on first need ──
  // Kept out of the page so /programme paints and becomes interactive on a
  // weak connection; see src/pages/programme/details.json.ts.
  let details = null;
  let detailsPromise = null;

  function loadDetails() {
    if (!detailsPromise) {
      detailsPromise = fetch('/programme/details.json')
        .then((res) => {
          if (!res.ok) throw new Error(`details.json: HTTP ${res.status}`);
          return res.json();
        })
        .then((data) => {
          details = data;
          rebuildSearchIndex();
          return data;
        })
        .catch((err) => {
          // Let the next attempt retry, e.g. once the connection is back.
          detailsPromise = null;
          throw err;
        });
    }
    return detailsPromise;
  }

  // Search index. Titles, speakers, track and audience are searchable at once;
  // abstracts join in as soon as details.json has arrived.
  const searchIndex = new Map();

  function rebuildSearchIndex() {
    for (const t of talks) {
      searchIndex.set(
        t.code,
        [
          t.title,
          t.speakers.map((s) => s.name).join(' '),
          t.track,
          t.audience,
          toPlainText(details?.[t.code]?.descriptionHtml),
        ]
          .join(' ')
          .toLowerCase(),
      );
    }
  }
  rebuildSearchIndex();

  // ── Favorites (localStorage, scoped by event slug) ──
  const STORAGE_KEY = `cdl-favorites-${eventSlug}`;

  function getFavorites() {
    try { return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]')); }
    catch { return new Set(); }
  }
  function saveFavorites(favs) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favs]));
  }
  function toggleFavorite(code) {
    const favs = getFavorites();
    if (favs.has(code)) favs.delete(code); else favs.add(code);
    saveFavorites(favs);
    syncFavUI();
    return favs.has(code);
  }

  function syncFavUI() {
    const favs = getFavorites();
    // Card fav buttons
    document.querySelectorAll('.fav-btn').forEach((btn) => {
      const code = btn.getAttribute('data-fav');
      const active = favs.has(code);
      btn.querySelector('.fav-off')?.classList.toggle('hidden', active);
      btn.querySelector('.fav-on')?.classList.toggle('hidden', !active);
      btn.setAttribute('aria-label', active ? 'Retirer des favoris' : 'Ajouter aux favoris');
      // Highlight card border
      const card = btn.closest('.relative')?.querySelector('.talk-card');
      if (card) {
        card.classList.toggle('border-cdl-orange/40', active);
        card.classList.toggle('ring-1', active);
        card.classList.toggle('ring-cdl-orange/20', active);
      }
    });
    // Filter button counter
    const count = favs.size;
    const countEl = document.getElementById('fav-count');
    if (countEl) {
      countEl.textContent = String(count);
      countEl.classList.toggle('hidden', count === 0);
    }
    // Export button visibility
    const exportBtn = document.getElementById('export-favs');
    if (exportBtn) exportBtn.classList.toggle('hidden', count === 0);
    // Modal fav button
    const modalFavBtn = document.getElementById('modal-fav');
    if (modalFavBtn) {
      const code = modalFavBtn.getAttribute('data-code');
      const active = favs.has(code);
      modalFavBtn.querySelector('.modal-fav-off')?.classList.toggle('hidden', active);
      modalFavBtn.querySelector('.modal-fav-on')?.classList.toggle('hidden', !active);
      modalFavBtn.setAttribute('aria-label', active ? 'Retirer des favoris' : 'Ajouter aux favoris');
    }
    // Re-apply filters if fav filter is active
    if (favFilterActive) applyFilters();
    // The "En ce moment" panel highlights and sorts by favourites too.
    updateNowPanel(getNow());
  }

  // Card fav buttons
  document.querySelectorAll('.fav-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const code = btn.getAttribute('data-fav');
      toggleFavorite(code);
    });
  });

  // ── Fav filter toggle ──
  let favFilterActive = false;
  const favFilterBtn = document.getElementById('filter-favs');

  favFilterBtn?.addEventListener('click', () => {
    favFilterActive = !favFilterActive;
    favFilterBtn.setAttribute('aria-pressed', String(favFilterActive));
    favFilterBtn.classList.toggle('border-cdl-orange', favFilterActive);
    favFilterBtn.classList.toggle('text-cdl-orange', favFilterActive);
    favFilterBtn.classList.toggle('bg-cdl-orange/5', favFilterActive);
    favFilterBtn.querySelector('.fav-icon-off')?.classList.toggle('hidden', favFilterActive);
    favFilterBtn.querySelector('.fav-icon-on')?.classList.toggle('hidden', !favFilterActive);
    applyFilters();
  });

  // ── Day tabs ──
  const tabs = document.querySelectorAll('.day-tab');
  const panels = document.querySelectorAll('.day-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('bg-white', 'dark:bg-gray-800', 'text-cdl-orange', 'shadow-sm');
        t.classList.add('text-cdl-gray');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('bg-white', 'dark:bg-gray-800', 'text-cdl-orange', 'shadow-sm');
      tab.classList.remove('text-cdl-gray');
      tab.setAttribute('aria-selected', 'true');

      const day = tab.getAttribute('data-tab-day');
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.getAttribute('data-day-panel') !== day);
      });
      applyFilters();
    });
  });

  // ── Search + filters ──
  const searchInput = document.getElementById('search');
  const trackSelect = document.getElementById('filter-track');
  const typeSelect = document.getElementById('filter-type');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters');

  let searchTimeout;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(applyFilters, 150);
  });
  // Start fetching abstracts as soon as someone means to search, and re-run the
  // query once they are in so matches inside descriptions show up too.
  searchInput?.addEventListener('focus', () => {
    if (details) return;
    loadDetails().then(applyFilters, () => {});
  });
  trackSelect?.addEventListener('change', applyFilters);
  typeSelect?.addEventListener('change', applyFilters);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (trackSelect) trackSelect.value = 'all';
    if (typeSelect) typeSelect.value = 'all';
    if (favFilterActive) favFilterBtn?.click();
    applyFilters();
  });

  function applyFilters() {
    const query = searchInput?.value?.toLowerCase().trim() || '';
    const track = trackSelect?.value || 'all';
    const type = typeSelect?.value || 'all';
    const favs = favFilterActive ? getFavorites() : null;

    let visible = 0;
    let total = 0;

    // Apply on ALL day panels (not just visible) so counts are correct
    const activePanel = document.querySelector('.day-panel:not(.hidden)');
    if (!activePanel) return;

    activePanel.querySelectorAll('.talk-card').forEach((card) => {
      total++;
      const code = card.getAttribute('data-code');
      const matchSearch = !query || (searchIndex.get(code) || '').includes(query);
      const matchTrack = track === 'all' || card.getAttribute('data-track') === track;
      const matchType = type === 'all' || card.getAttribute('data-type') === type;
      const matchFav = !favs || favs.has(code);
      const show = matchSearch && matchTrack && matchType && matchFav;
      // Hide the wrapper div (.relative parent)
      const wrapper = card.closest('.relative');
      if (wrapper) wrapper.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // Hide empty time slots
    activePanel.querySelectorAll('.time-slot').forEach((slot) => {
      const hasVisible = slot.querySelector('.relative:not([style*="display: none"])');
      slot.style.display = hasVisible ? '' : 'none';
    });

    const hasFilter = query || track !== 'all' || type !== 'all' || favFilterActive;
    resultsCount.textContent = hasFilter
      ? `${visible} résultat${visible > 1 ? 's' : ''} sur ${total}`
      : '';

    noResults?.classList.toggle('hidden', visible > 0);
  }

  // ── Modal ──
  const modal = document.getElementById('talk-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalMeta = document.getElementById('modal-meta');
  const modalBadges = document.getElementById('modal-badges');
  const modalSpeakers = document.getElementById('modal-speakers');
  const modalDescription = document.getElementById('modal-description');
  const modalClose = document.getElementById('modal-close');
  const modalFav = document.getElementById('modal-fav');

  /**
   * Opens the detail modal and, unless we are replaying history, points the
   * address bar at the session's own page.
   *
   * The URL is what makes a session shareable: /programme/talk/<code>/ is a
   * real static page carrying the talk's own title, description and social
   * card, so the link the visitor copies out of the address bar (or out of the
   * share button) unfurls as that talk everywhere. Reloading it, or opening it
   * cold, lands on the full page instead of the modal — same content, no JS
   * required.
   */
  function openModal(code, { push = true } = {}) {
    const talk = talksMap.get(code);
    if (!talk || !modal) return;

    modalTitle.textContent = talk.title;
    modal.dataset.code = code;
    modalFav.setAttribute('data-code', code);

    // Badges
    modalBadges.innerHTML = '';
    if (talk.type) {
      const cls = talk.type.toLowerCase().includes('atelier')
        ? 'bg-cdl-gold/20 text-cdl-orange-dark'
        : talk.type.toLowerCase().includes('keynote')
          ? 'bg-cdl-orange/10 text-cdl-orange'
          : 'bg-cdl-gray-light text-cdl-gray';
      modalBadges.innerHTML += `<span class="text-xs font-medium px-2.5 py-1 rounded-full ${cls}">${talk.type}</span>`;
    }
    if (talk.track) {
      modalBadges.innerHTML += `<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-cdl-blue/5 text-cdl-blue-light">${talk.track}</span>`;
    }

    // Meta
    const metaParts = [];
    if (talk.startFormatted && talk.endFormatted) {
      metaParts.push(`<span class="inline-flex items-center gap-1"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>${talk.startFormatted} — ${talk.endFormatted}</span>`);
    }
    if (talk.room) {
      metaParts.push(`<span class="inline-flex items-center gap-1"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>Salle ${talk.room}</span>`);
    }
    metaParts.push(`<span>${talk.duration} min</span>`);
    modalMeta.innerHTML = metaParts.join('<span class="text-cdl-gray-light">·</span>');

    // Public visé
    const modalAudience = document.getElementById('modal-audience');
    const modalAudienceText = document.getElementById('modal-audience-text');
    if (modalAudience && modalAudienceText) {
      modalAudienceText.textContent = talk.audience || '';
      modalAudience.classList.toggle('hidden', !talk.audience);
    }

    // Room info with mini plan
    const modalRoomInfo = document.getElementById('modal-room-info');
    const modalRoomText = document.getElementById('modal-room-text');
    const modalRoomPlan = document.getElementById('modal-room-plan');
    if (modalRoomInfo && modalRoomText) {
      const ri = talk.room ? rooms[talk.room] : null;
      if (ri) {
        modalRoomText.innerHTML = `
          <div class="flex items-start gap-3 p-4 rounded-xl border" style="border-color: ${ri.color}20; background-color: ${ri.color}05">
            <div class="flex-shrink-0 h-10 w-10 rounded-lg flex items-center justify-center font-bold text-white text-lg" style="background-color: ${ri.color}">
              ${ri.buildingLetter}
            </div>
            <div>
              <p class="font-medium text-cdl-blue text-sm">${ri.label}</p>
              ${ri.directions ? `<p class="text-xs text-cdl-gray mt-0.5">${ri.directions}</p>` : ''}
            </div>
          </div>
        `;
        // Mini campus plan: clone the static CampusPlan and highlight the building
        const planTemplate = document.getElementById('campus-plan-template') as HTMLTemplateElement | null;
        if (modalRoomPlan && planTemplate) {
          const link = document.createElement('a');
          link.href = '/lieu/';
          link.title = 'Voir le plan complet';
          link.className = 'block rounded-xl overflow-hidden border border-cdl-gray-light hover:border-cdl-orange/30 transition-colors p-3';

          const clone = planTemplate.content.cloneNode(true) as DocumentFragment;
          clone.querySelectorAll('.cp-bld').forEach((b) => {
            const letter = b.getAttribute('data-building');
            b.classList.add(letter === ri.buildingLetter ? 'is-active' : 'is-dimmed');
          });
          link.appendChild(clone);

          modalRoomPlan.replaceChildren(link);
          modalRoomPlan.classList.remove('hidden');
        }
        modalRoomInfo.classList.remove('hidden');
      } else {
        modalRoomInfo.classList.add('hidden');
      }
    }

    renderSpeakers(talk);

    // Resources (slides, videos, links)
    const modalResources = document.getElementById('modal-resources');
    if (modalResources) {
      if (talk.resources && talk.resources.length > 0) {
        const iconForUrl = (url) => {
          if (url.endsWith('.pdf') || url.includes('/pdf')) return '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>';
          if (url.includes('video') || url.includes('peertube') || url.includes('youtube') || url.includes('youtu.be')) return '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
          return '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>';
        };
        modalResources.innerHTML = `
          <h3 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">Ressources</h3>
          <div class="flex flex-wrap gap-2">
            ${talk.resources.map((r) => `
              <a href="${r.url}" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-cdl-orange bg-cdl-orange/5 hover:bg-cdl-orange/10 border border-cdl-orange/20 rounded-lg transition-colors">
                ${iconForUrl(r.url)}
                ${r.description || 'Ressource'}
              </a>
            `).join('')}
          </div>
        `;
        modalResources.classList.remove('hidden');
      } else {
        modalResources.classList.add('hidden');
      }
    }

    renderDescription(talk);
    if (!details) {
      // Fill bios and abstract in place once they arrive, unless the visitor
      // has moved on to another session in the meantime.
      loadDetails().then(
        () => {
          if (modal.dataset.code !== code) return;
          renderSpeakers(talk);
          renderDescription(talk);
        },
        () => {
          if (modal.dataset.code !== code) return;
          modalDescription.innerHTML =
            `<p>Description indisponible pour le moment. <a href="${talkPath(code)}">Voir la page de la session</a>.</p>`;
        },
      );
    }

    syncFavUI();
    if (push && history.state?.cdlTalk !== code) {
      history.pushState({ cdlTalk: code, pushed: true }, '', historyHref(talkPath(code)));
    }
    modal.showModal();
  }

  /** Speakers with avatar, plus their bio once details.json is loaded. */
  function renderSpeakers(talk) {
    if (talk.speakers.length === 0) {
      modalSpeakers.innerHTML = '';
      return;
    }
    const bios = details?.[talk.code]?.bios || [];
    const speakerLabel = talk.speakers.length > 1 ? 'Intervenant·es' : 'Intervenant·e';
    modalSpeakers.innerHTML = `
      <h3 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">${speakerLabel}</h3>
      <div class="space-y-3">
        ${talk.speakers.map((speaker, i) => {
          const avatarHtml = speaker.avatar
            ? `<img src="${speaker.avatar}" alt="" class="h-10 w-10 rounded-full object-cover flex-shrink-0" width="40" height="40" loading="lazy" />`
            : `<span class="h-10 w-10 rounded-full bg-cdl-orange/10 flex items-center justify-center text-sm font-bold text-cdl-orange flex-shrink-0">${speaker.name.charAt(0)}</span>`;
          const bioHtml = bios[i]
            ? `<div class="text-xs text-cdl-gray mt-1 leading-relaxed prose max-w-none">${bios[i]}</div>`
            : '';
          return `
            <div class="flex gap-3 p-3 bg-cdl-bg rounded-xl">
              ${avatarHtml}
              <div class="min-w-0">
                <p class="font-medium text-cdl-blue text-sm">${speaker.name}</p>
                ${bioHtml}
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  /** Abstract (pre-rendered markdown), or a placeholder while it loads. */
  function renderDescription(talk) {
    if (!details) {
      modalDescription.innerHTML = '<p class="text-cdl-gray/80">Chargement de la description…</p>';
      return;
    }
    modalDescription.innerHTML =
      details[talk.code]?.descriptionHtml || '<p>Pas de description disponible.</p>';
  }

  document.querySelectorAll('.talk-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      // The card is a real link to the session's page, so that middle-click,
      // ctrl/cmd-click, "open in new tab" and "copy link address" all work —
      // the gestures people actually reach for when they want to send a talk
      // to someone — and so crawlers can reach the 123 session pages from
      // here rather than only through the sitemap. A plain left click is the
      // only one we intercept: it opens the modal instead of navigating.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      openModal(card.getAttribute('data-code'));
    });
  });

  // Modal fav button
  modalFav?.addEventListener('click', () => {
    const code = modalFav.getAttribute('data-code');
    if (code) toggleFavorite(code);
  });

  modalClose?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  // Closing (button, backdrop or Escape) must take the talk URL back off the
  // address bar, or the visitor is left on /programme/ showing a talk's URL.
  modal?.addEventListener('close', () => {
    if (!history.state?.cdlTalk) return;
    if (history.state.pushed) history.back();
    else history.replaceState({}, '', historyHref('/programme/'));
  });

  // Back/forward across modal opens, and the browser restoring a talk URL.
  window.addEventListener('popstate', (e) => {
    const code = e.state?.cdlTalk;
    if (code && talksMap.has(code)) openModal(code, { push: false });
    else if (modal?.open) modal.close();
  });

  // ── Partage ──
  const modalShare = document.getElementById('modal-share');
  const modalShareLabel = document.getElementById('modal-share-label');
  const modalShareStatus = document.getElementById('modal-share-status');

  /** navigator.clipboard needs a secure context; the textarea works everywhere else. */
  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(field);
      return ok;
    }
  }

  let shareLabelTimer;

  modalShare?.addEventListener('click', async () => {
    const code = modal?.dataset.code;
    const talk = code ? talksMap.get(code) : null;
    if (!talk) return;
    const url = talkUrl(code);

    // Native share sheet where there is one (mobile, Safari); clipboard elsewhere.
    if (navigator.share) {
      try {
        await navigator.share({ title: talk.title, url });
        return;
      } catch (err) {
        if (err?.name === 'AbortError') return;
      }
    }

    const copied = await copyText(url);
    const message = copied ? 'Lien copié !' : 'Copie impossible';
    if (modalShareStatus) modalShareStatus.textContent = message;
    if (modalShareLabel) modalShareLabel.textContent = message;
    // The aria-label is the button's accessible name and overrides the visible
    // text, so it has to follow it — otherwise a voice-control user reading
    // "Lien copié !" on screen has no way to address the control.
    modalShare.setAttribute('aria-label', message);
    clearTimeout(shareLabelTimer);
    shareLabelTimer = setTimeout(() => {
      if (modalShareStatus) modalShareStatus.textContent = '';
      if (modalShareLabel) modalShareLabel.textContent = 'Partager';
      modalShare.setAttribute('aria-label', 'Partager cette session');
    }, 2500);
  });

  /**
   * Deep link on arrival. `/programme/?talk=<code>` still opens the modal — it
   * is the shape of any link shared before session pages existed — and is
   * rewritten to the session's own URL. Today's shared links point straight at
   * that page, which never runs this script.
   */
  function openFromUrl() {
    const url = new URL(location.href);

    // Offline, the service worker answers a session URL it has not cached with
    // this page (see src/pwa/sw.js): open that session's modal on top of it.
    const pathCode = url.pathname.match(/^\/programme\/talk\/([^/]+)\/$/)?.[1];
    if (pathCode && talksMap.has(pathCode)) {
      history.replaceState({ cdlTalk: pathCode, pushed: false }, '', location.href);
      openModal(pathCode, { push: false });
      return;
    }

    const code = url.searchParams.get('talk');
    if (!code || !talksMap.has(code)) return;
    url.searchParams.delete('talk');
    history.replaceState(
      { cdlTalk: code, pushed: false },
      '',
      talkPath(code) + url.search,
    );
    openModal(code, { push: false });
  }

  // ── Export favorites as .ics ──
  function pad2(n) { return String(n).padStart(2, '0'); }

  function formatIcsDate(iso) {
    const d = new Date(iso);
    return d.getUTCFullYear() +
      pad2(d.getUTCMonth() + 1) +
      pad2(d.getUTCDate()) + 'T' +
      pad2(d.getUTCHours()) +
      pad2(d.getUTCMinutes()) +
      pad2(d.getUTCSeconds()) + 'Z';
  }

  function escapeIcs(text) {
    return String(text || '')
      .replace(/\\/g, '\\\\')
      .replace(/;/g, '\\;')
      .replace(/,/g, '\\,')
      .replace(/\r?\n/g, '\\n');
  }

  const icsEncoder = new TextEncoder();

  /**
   * Content lines are capped at 75 *octets*, and continuations start with a
   * space. Counting characters overflowed the limit on accented French text
   * and could cut an emoji in half. Mirrors fold() in src/lib/ics.ts.
   */
  function foldIcsLine(line) {
    if (icsEncoder.encode(line).length <= 75) return line;

    const folded = [];
    let current = '';
    let bytes = 0;

    for (const char of line) {
      const size = icsEncoder.encode(char).length;
      if (bytes + size > 75) {
        folded.push(current);
        current = ' ';
        bytes = 1;
      }
      current += char;
      bytes += size;
    }
    folded.push(current);

    return folded.join('\r\n');
  }

  function buildIcs(favTalks) {
    const stamp = formatIcsDate(new Date().toISOString());
    const lines = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Capitole du Libre//Programme//FR',
      'CALSCALE:GREGORIAN',
      'METHOD:PUBLISH',
    ];
    for (const t of favTalks) {
      if (!t.start || !t.end) continue;
      const speakers = t.speakers.map((s) => s.name).join(', ');
      const summary = speakers ? `${t.title} — ${speakers}` : t.title;
      const descParts = [];
      if (t.track) descParts.push(`Track : ${t.track}`);
      if (t.type) descParts.push(`Format : ${t.type}`);
      if (t.audience) descParts.push(`Public visé : ${t.audience}`);
      const summaryText = toPlainText(details?.[t.code]?.descriptionHtml);
      if (summaryText) { descParts.push(''); descParts.push(summaryText); }
      lines.push(
        'BEGIN:VEVENT',
        `UID:${t.code}@capitoledulibre.org`,
        `DTSTAMP:${stamp}`,
        `DTSTART:${formatIcsDate(t.start)}`,
        `DTEND:${formatIcsDate(t.end)}`,
        `SUMMARY:${escapeIcs(summary)}`,
        // Same wording as the per-talk event.ics (src/lib/ics.ts): "A201"
        // alone tells a calendar entry's reader nothing six months later.
        ...(t.room ? [`LOCATION:${escapeIcs(`${venueName} — Salle ${t.room}`)}`] : []),
        `DESCRIPTION:${escapeIcs(descParts.join('\n'))}`,
        `URL:${talkUrl(t.code)}`,
        'END:VEVENT',
      );
    }
    lines.push('END:VCALENDAR');
    return lines.map(foldIcsLine).join('\r\n');
  }

  async function downloadFavoritesIcs() {
    const favs = getFavorites();
    const favTalks = talks.filter((t) => favs.has(t.code));
    if (favTalks.length === 0) return;
    // Abstracts make the calendar entries useful, but an export offline (or
    // with Pretalx data unreachable) still beats no export at all.
    try { await loadDetails(); } catch { /* export without descriptions */ }
    const ics = buildIcs(favTalks);
    const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `cdl-${eventSlug}-favoris.ics`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 0);
  }

  document.getElementById('export-favs')?.addEventListener('click', downloadFavoritesIcs);

  // ── Now indicator (during event) ──
  const NOW_REFRESH_MS = 60_000;

  function getNow() {
    const debug = new URL(window.location.href).searchParams.get('now');
    if (debug) {
      const d = new Date(debug);
      if (!isNaN(d.getTime())) return d;
    }
    return new Date();
  }

  function localDateStr(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function clearNowMarkers() {
    document.querySelectorAll('.time-slot').forEach((slot) => {
      slot.classList.remove('is-current', 'is-next');
      slot.querySelector('.now-badge')?.remove();
    });
  }

  function addNowBadge(slot, kind) {
    const marker = slot.querySelector('[data-slot-marker]');
    if (!marker || marker.querySelector('.now-badge')) return;
    const badge = document.createElement('div');
    badge.className =
      'now-badge mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-bold rounded uppercase tracking-wide ' +
      (kind === 'current' ? 'bg-red-600 text-white' : 'bg-cdl-blue text-white');
    badge.innerHTML = kind === 'current'
      ? '<span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>En cours'
      : 'Prochain';
    marker.appendChild(badge);
  }

  function updateNowIndicator() {
    clearNowMarkers();
    const now = getNow();
    updateNowPanel(now);
    const nowMs = now.getTime();
    const todayPanel = document.querySelector(`[data-day-panel="${localDateStr(now)}"]`);
    if (!todayPanel) return;

    let current = null;
    let next = null;
    let nextStartMs = Infinity;

    todayPanel.querySelectorAll('.time-slot').forEach((slot) => {
      const startStr = slot.getAttribute('data-slot-time');
      const endStr = slot.getAttribute('data-slot-end');
      if (!startStr) return;
      const startMs = new Date(startStr).getTime();
      const endMs = endStr ? new Date(endStr).getTime() : startMs;
      if (nowMs >= startMs && nowMs < endMs) {
        current = slot;
      } else if (nowMs < startMs && startMs < nextStartMs) {
        next = slot;
        nextStartMs = startMs;
      }
    });

    if (current) {
      current.classList.add('is-current');
      addNowBadge(current, 'current');
    } else if (next) {
      next.classList.add('is-next');
      addNowBadge(next, 'next');
    }
  }

  // ── "En ce moment" panel ──
  // The slot badges above mark a single slot, but sessions do not share slots:
  // a 2-hour workshop started at 14:00 is still on at 15:10 while a talk
  // started at 15:00 is too. This panel lists every session actually on, room
  // by room, and what starts soon — the view people want while in the hallway.

  const NOW_PANEL_LEAD_MS = 60 * 60_000; // show the panel 1h before the first session of the day
  const UPCOMING_WINDOW_MS = 45 * 60_000; // "À suivre" covers the next 45 minutes

  const nowPanel = document.getElementById('maintenant');
  const nowCurrentList = document.getElementById('now-current');
  const nowCurrentEmpty = document.getElementById('now-current-empty');
  const nowNextBlock = document.getElementById('now-next-block');
  const nowNextList = document.getElementById('now-next');
  const nowClock = document.getElementById('now-clock');

  const timedTalks = talks.filter((t) => t.start && t.end);
  const startMs = (t) => new Date(t.start).getTime();
  const endMs = (t) => new Date(t.end).getTime();
  const byRoom = (a, b) => (a.room || '').localeCompare(b.room || '');

  const clockFormat = new Intl.DateTimeFormat('fr-FR', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Paris',
  });

  /** One compact card for the panel; a real link, opened in the modal on plain click. */
  function nowItem(talk, kind, nowMs, favs) {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = talkPath(talk.code);
    a.dataset.code = talk.code;
    a.className =
      'now-item block h-full p-3 rounded-xl border border-cdl-gray-light hover:border-cdl-orange/40 hover:shadow-sm transition-all bg-cdl-bg dark:bg-gray-900 group';
    if (favs.has(talk.code)) a.classList.add('border-cdl-orange/40', 'ring-1', 'ring-cdl-orange/20');

    const meta = document.createElement('span');
    meta.className = 'flex items-center gap-1.5 flex-wrap text-[11px] mb-1';
    const room = document.createElement('span');
    room.className = 'font-medium text-cdl-blue-light bg-cdl-blue/5 px-2 py-0.5 rounded';
    room.textContent = talk.room ? `Salle ${talk.room}` : talk.type || '';
    if (talk.room && rooms[talk.room]) room.title = rooms[talk.room].label;
    const when = document.createElement('span');
    when.className = 'text-cdl-gray';
    if (kind === 'current') {
      const left = Math.max(1, Math.round((endMs(talk) - nowMs) / 60_000));
      when.textContent = `jusqu'à ${talk.endFormatted} · encore ${left} min`;
    } else {
      const inMin = Math.max(0, Math.round((startMs(talk) - nowMs) / 60_000));
      when.textContent = `à ${talk.startFormatted}` + (inMin > 0 ? ` · dans ${inMin} min` : '');
    }
    meta.append(room, when);
    if (favs.has(talk.code)) {
      const fav = document.createElement('span');
      fav.className = 'text-cdl-orange font-medium';
      fav.textContent = '♥ favori';
      meta.append(fav);
    }

    const title = document.createElement('span');
    title.className =
      'block font-medium text-sm text-cdl-blue group-hover:text-cdl-orange transition-colors leading-snug';
    title.textContent = talk.title;
    a.append(meta, title);

    if (talk.speakers.length > 0) {
      const speakers = document.createElement('span');
      speakers.className = 'block text-xs text-cdl-gray mt-1';
      speakers.textContent = talk.speakers.map((sp) => sp.name).join(', ');
      a.append(speakers);
    }

    li.append(a);
    return li;
  }

  /** Favourites first, then room order, so "my" session is the first thing seen. */
  function sortForPanel(list, favs) {
    return list.sort((a, b) => Number(favs.has(b.code)) - Number(favs.has(a.code)) || byRoom(a, b));
  }

  function updateNowPanel(now) {
    if (!nowPanel || !nowCurrentList || !nowNextList) return;
    const nowMs = now.getTime();
    const today = timedTalks.filter((t) => localDateStr(new Date(t.start)) === localDateStr(now));

    const dayStart = Math.min(...today.map(startMs)) - NOW_PANEL_LEAD_MS;
    const dayEnd = Math.max(...today.map(endMs));
    if (today.length === 0 || nowMs < dayStart || nowMs >= dayEnd) {
      nowPanel.classList.add('hidden');
      return;
    }

    const favs = getFavorites();
    const current = sortForPanel(
      today.filter((t) => startMs(t) <= nowMs && nowMs < endMs(t)),
      favs,
    );
    const upcomingAll = today.filter((t) => startMs(t) > nowMs);
    const firstUpcoming = Math.min(...upcomingAll.map(startMs));
    // Everything in the next 45 minutes; failing that, the next slot however far.
    const upcoming = upcomingAll
      .filter((t) => startMs(t) <= Math.max(nowMs + UPCOMING_WINDOW_MS, firstUpcoming))
      .sort((a, b) => startMs(a) - startMs(b) || Number(favs.has(b.code)) - Number(favs.has(a.code)) || byRoom(a, b));

    nowCurrentList.replaceChildren(...current.map((t) => nowItem(t, 'current', nowMs, favs)));
    nowCurrentList.classList.toggle('hidden', current.length === 0);
    nowCurrentEmpty?.classList.toggle('hidden', current.length > 0);
    nowNextList.replaceChildren(...upcoming.map((t) => nowItem(t, 'next', nowMs, favs)));
    nowNextBlock?.classList.toggle('hidden', upcoming.length === 0);
    if (nowClock) nowClock.textContent = `Mis à jour à ${clockFormat.format(now)}`;

    nowPanel.classList.remove('hidden');
  }

  nowPanel?.addEventListener('click', (e) => {
    const link = e.target.closest('.now-item');
    if (!link) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    e.preventDefault();
    openModal(link.dataset.code);
  });

  function selectTodayTabIfPresent() {
    const todayTab = document.querySelector(`.day-tab[data-tab-day="${localDateStr(getNow())}"]`);
    if (todayTab && todayTab.getAttribute('aria-selected') !== 'true') {
      todayTab.click();
    }
  }

  function scrollToCurrentOnce() {
    if (window.scrollY > 100) return;
    // During the event the panel is the view people came for; otherwise the
    // slot on now or next. On a phone the filter bar alone fills the first
    // screen, so without this the panel would sit below the fold.
    const panelShown = nowPanel && !nowPanel.classList.contains('hidden');
    const target = panelShown
      ? nowPanel
      : document.querySelector('.time-slot.is-current') || document.querySelector('.time-slot.is-next');
    if (!target) return;
    // Clear the site header (top-16) and the sticky filter bar, whose height
    // depends on how its controls wrap.
    const filterBar = document.getElementById('filter-bar');
    const clearance = 64 + (filterBar?.offsetHeight ?? 116) + 16;
    const rect = target.getBoundingClientRect();
    const offset = window.scrollY + rect.top - clearance;
    window.scrollTo({ top: Math.max(0, offset), behavior: 'smooth' });
  }

  // ── Offline status ──
  // The service worker (src/pwa/sw.js) precaches this page. Say so, since
  // nobody would think to try the site with no network otherwise — and once
  // offline, say how old the copy on screen is.
  const offlineStatus = document.getElementById('offline-status');
  const builtAt = dataEl?.dataset.builtAt ? new Date(dataEl.dataset.builtAt) : null;
  const builtAtFormat = new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Paris',
  });

  function updateOfflineStatus() {
    if (!offlineStatus) return;
    let text = '';
    if (!navigator.onLine) {
      text = builtAt
        ? `Hors connexion : programme tel que publié le ${builtAtFormat.format(builtAt)}.`
        : 'Hors connexion : programme enregistré sur cet appareil.';
    } else if (navigator.serviceWorker?.controller) {
      text = '✓ Ce programme reste consultable hors connexion sur cet appareil.';
    }
    offlineStatus.textContent = text;
    offlineStatus.classList.toggle('hidden', !text);
  }

  window.addEventListener('online', updateOfflineStatus);
  window.addEventListener('offline', updateOfflineStatus);
  navigator.serviceWorker?.addEventListener('controllerchange', updateOfflineStatus);

  // ── Init ──
  updateOfflineStatus();
  syncFavUI();
  selectTodayTabIfPresent();
  applyFilters();
  openFromUrl();
  updateNowIndicator();
  setTimeout(scrollToCurrentOnce, 150);
  setInterval(updateNowIndicator, NOW_REFRESH_MS);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') updateNowIndicator();
  });
</script>
