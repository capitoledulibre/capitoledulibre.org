---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CampusPlan from '../../../../components/ui/CampusPlan.astro';
import JsonLd from '../../../../components/ui/JsonLd.astro';
import OccitanCross from '../../../../components/ui/OccitanCross.astro';
import TicketCta from '../../../../components/ui/TicketCta.astro';
import { config } from '../../../../config';
import { breadcrumb, sessionEvents } from '../../../../lib/jsonld';
import { renderMarkdown } from '../../../../lib/markdown';
import type { FormattedTalk } from '../../../../lib/pretalx';
import { parseRoom } from '../../../../lib/rooms';
import {
  formatTalkDay,
  formatTalkTime,
  pretalxTalkUrl,
  speakerList,
  talkCardPath,
  talkMetaDescription,
  talkPath,
  talkRoutes,
  truncate,
} from '../../../../lib/talks';

/**
 * One page per session.
 *
 * This is the URL the "Partager" button hands out, and the reason it exists:
 * /programme is a single page whose modal lives in a query-free URL, so every
 * shared talk unfurled as the same generic event card. A real page per talk
 * gets its own title, description, social card and structured data — and it
 * still works with JavaScript off, unlike the modal.
 */

export async function getStaticPaths() {
  const talks = await talkRoutes();

  return talks.map((talk) => ({
    params: { code: talk.code },
    props: {
      talk,
      // What else is on in the same slot — the question anyone reading a
      // session page is about to ask. Matched on an identical start rather
      // than on a real interval overlap: the schedule is built in slots and
      // that is how /programme presents a day, and overlap would list a
      // median of 13 sessions (25 for the worst one), which is a wall, not
      // an answer.
      concurrent: talks
        .filter((t) => t.code !== talk.code && t.start && t.start === talk.start)
        .sort((a, b) => (a.room ?? '').localeCompare(b.room ?? '')),
    },
  }));
}

interface Props {
  talk: FormattedTalk;
  concurrent: FormattedTalk[];
}

const { talk, concurrent } = Astro.props;


const room = talk.room ? parseRoom(talk.room) : null;
const speakers = speakerList(talk);
const day = formatTalkDay(talk.start);
const start = formatTalkTime(talk.start);
const end = formatTalkTime(talk.end);

const isWorkshop = talk.type?.toLowerCase().includes('atelier');
const isKeynote = talk.type?.toLowerCase().includes('keynote');

/**
 * Only claim this session belongs to the advertised edition once Pretalx is
 * actually serving that edition. Until then /programme shows the previous
 * programme, and describing those talks as this year's would be false.
 */
const isCurrentEdition = config.pretalx.eventSlug === `cdl-${config.edition.year}`;

const sessionNode = isCurrentEdition
  ? {
      '@context': 'https://schema.org',
      ...sessionEvents([talk], (code) => new URL(talkPath(code), Astro.site).href)[0],
      image: new URL(talkCardPath(talk.code), Astro.site).href,
    }
  : null;

// "Ajouter à mon agenda" points at the sibling endpoint, which serialises the
// same session — see src/pages/programme/talk/[code]/event.ics.ts.
const icsUrl = talk.start && talk.end ? `${talkPath(talk.code)}event.ics` : null;
---

<BaseLayout
  title={truncate(talk.title, 70)}
  description={talkMetaDescription(talk)}
  ogImage={talkCardPath(talk.code)}
  ogImageAlt={`${talk.title}${speakers ? ` — ${speakers}` : ''} · Capitole du Libre ${config.edition.year}`}
  ogImageSize={{ width: 1200, height: 630 }}
  ogType="article"
>
  <JsonLd
    slot="head"
    data={breadcrumb([
      { name: 'Programme', path: '/programme/' },
      { name: talk.title, path: talkPath(talk.code) },
    ])}
  />
  {sessionNode && <JsonLd slot="head" data={sessionNode} />}

  {/* ── En-tête ── */}
  <div class="relative bg-cdl-blue-fixed text-white py-12 sm:py-16 overflow-hidden">
    <OccitanCross size={220} class="absolute -top-12 -right-12 text-white/[0.04] rotate-12" />

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <a
        href="/programme/"
        class="inline-flex items-center gap-1.5 text-sm text-white/70 hover:text-cdl-gold transition-colors mb-6"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Tout le programme
      </a>

      {(talk.type || talk.track) && (
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {talk.type && (
            <span
              class:list={[
                'text-xs font-medium px-2.5 py-1 rounded-full',
                isWorkshop
                  ? 'bg-cdl-gold/25 text-cdl-gold'
                  : isKeynote
                    ? 'bg-cdl-orange-light/25 text-cdl-gold'
                    : 'bg-white/10 text-white/85',
              ]}
            >
              {talk.type}
            </span>
          )}
          {talk.track && (
            <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-white/10 text-white/85">
              {talk.track}
            </span>
          )}
        </div>
      )}

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight mb-5 max-w-4xl">
        {talk.title}
      </h1>

      {talk.speakers.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-5">
          {talk.speakers.map((speaker) => (
            <span class="inline-flex items-center gap-2 text-sm text-white/90">
              {speaker.avatar ? (
                <img
                  src={speaker.avatar}
                  alt=""
                  class="h-8 w-8 rounded-full object-cover ring-2 ring-white/20"
                  width="32"
                  height="32"
                  loading="lazy"
                />
              ) : (
                <span class="h-8 w-8 rounded-full bg-white/15 flex items-center justify-center text-xs font-bold">
                  {speaker.name.charAt(0)}
                </span>
              )}
              {speaker.name}
            </span>
          ))}
        </div>
      )}

      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/75">
        {day && <span class="capitalize">{day}</span>}
        {start && <span aria-hidden="true" class="text-white/30">·</span>}
        {start && <span>{end ? `${start} — ${end}` : start}</span>}
        <span aria-hidden="true" class="text-white/30">·</span>
        <span>{talk.duration} min</span>
        {talk.room && <span aria-hidden="true" class="text-white/30">·</span>}
        {talk.room && <span>Salle {talk.room}</span>}
      </p>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 40V20L1440 0V40H0Z" class="fill-cdl-bg" />
      </svg>
    </div>
  </div>

  {/* ── Corps ── */}
  <section class="py-10 sm:py-14">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">Description</h2>
          {talk.description ? (
            <div class="prose prose-sm sm:prose-base max-w-none" set:html={renderMarkdown(talk.description)} />
          ) : (
            <p class="text-cdl-gray">Pas encore de description pour cette session.</p>
          )}
        </div>

        {talk.audience && (
          <div>
            <h2 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">Public visé</h2>
            <p class="text-cdl-gray leading-relaxed">{talk.audience}</p>
          </div>
        )}

        {talk.resources.length > 0 && (
          <div>
            <h2 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">Ressources</h2>
            <div class="flex flex-wrap gap-2">
              {talk.resources.map((resource) => (
                <a
                  href={resource.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-cdl-orange bg-cdl-orange/5 hover:bg-cdl-orange/10 border border-cdl-orange/20 rounded-lg transition-colors"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                  {resource.description || 'Ressource'}
                </a>
              ))}
            </div>
          </div>
        )}

        {talk.speakers.some((s) => s.biography) && (
          <div>
            <h2 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">
              {talk.speakers.length > 1 ? 'Intervenant·es' : 'Intervenant·e'}
            </h2>
            <div class="space-y-3">
              {talk.speakers.map((speaker) => (
                <div class="flex gap-3 p-4 bg-white dark:bg-gray-800 border border-cdl-gray-light rounded-xl">
                  {speaker.avatar ? (
                    <img
                      src={speaker.avatar}
                      alt=""
                      class="h-11 w-11 rounded-full object-cover flex-shrink-0"
                      width="44"
                      height="44"
                      loading="lazy"
                    />
                  ) : (
                    <span class="h-11 w-11 rounded-full bg-cdl-orange/10 flex items-center justify-center text-sm font-bold text-cdl-orange flex-shrink-0">
                      {speaker.name.charAt(0)}
                    </span>
                  )}
                  <div class="min-w-0">
                    <p class="font-medium text-cdl-blue">{speaker.name}</p>
                    {speaker.biography && (
                      <div class="prose prose-sm max-w-none mt-1" set:html={renderMarkdown(speaker.biography)} />
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {concurrent.length > 0 && (
          <div>
            <h2 class="text-sm font-semibold text-cdl-blue uppercase tracking-wider mb-3">
              Dans le même créneau
            </h2>
            <ul class="grid gap-2 sm:grid-cols-2">
              {concurrent.map((other) => (
                <li>
                  <a
                    href={talkPath(other.code)}
                    class="block h-full p-3 rounded-xl border border-cdl-gray-light hover:border-cdl-orange/40 hover:shadow-sm transition-all bg-white dark:bg-gray-800 group"
                  >
                    <span class="block text-[11px] text-cdl-gray mb-1">
                      {other.room ? `Salle ${other.room}` : other.type}
                    </span>
                    <span class="block font-medium text-sm text-cdl-blue group-hover:text-cdl-orange transition-colors leading-snug">
                      {other.title}
                    </span>
                    {other.speakers.length > 0 && (
                      <span class="block text-xs text-cdl-gray mt-1">{speakerList(other)}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {/* ── Colonne latérale ── */}
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="p-4 rounded-xl border border-cdl-gray-light bg-white dark:bg-gray-800 space-y-2">
          <button
            type="button"
            id="share-talk"
            data-url={new URL(talkPath(talk.code), Astro.site).href}
            data-title={talk.title}
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-cdl-orange hover:bg-cdl-orange-light rounded-lg transition-colors"
          >
            <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342a3 3 0 100-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684zm0-12a3 3 0 105.368-2.684 3 3 0 00-5.368 2.684z" />
            </svg>
            <span data-share-label>Partager</span>
          </button>
          <span id="share-status" role="status" aria-live="polite" class="sr-only"></span>

          <button
            type="button"
            id="fav-talk"
            data-code={talk.code}
            data-event-slug={config.pretalx.eventSlug}
            aria-pressed="false"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium border border-cdl-gray-light text-cdl-gray hover:border-cdl-orange/40 hover:text-cdl-orange rounded-lg transition-colors"
          >
            <svg class="fav-off h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <svg class="fav-on h-4 w-4 flex-shrink-0 hidden text-cdl-orange" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span data-fav-label>Ajouter à mes favoris</span>
          </button>

          {icsUrl && (
            <a
              href={icsUrl}
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium border border-cdl-gray-light text-cdl-gray hover:border-cdl-orange/40 hover:text-cdl-orange rounded-lg transition-colors"
            >
              <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Ajouter à mon agenda
            </a>
          )}

          <a
            href={pretalxTalkUrl(talk.code)}
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm text-cdl-gray hover:text-cdl-orange transition-colors"
          >
            Voir sur Pretalx
            <svg class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        {room && (
          <div class="rounded-xl border border-cdl-gray-light bg-white dark:bg-gray-800 overflow-hidden">
            <div class="flex items-start gap-3 p-4">
              <div
                class="flex-shrink-0 h-10 w-10 rounded-lg flex items-center justify-center font-bold text-white text-lg"
                style={`background-color: ${room.color}`}
              >
                {room.buildingLetter}
              </div>
              <div>
                <p class="font-medium text-cdl-blue text-sm">{room.label}</p>
                {room.directions && <p class="text-xs text-cdl-gray mt-0.5">{room.directions}</p>}
              </div>
            </div>
            {/* Without a name of its own, this link takes the plan's long
                `aria-label` as its accessible name — a paragraph describing
                the whole campus, read out as the link text. */}
            <a
              href="/lieu/"
              aria-label="Voir le plan complet du campus"
              class="block p-3 pt-0 hover:opacity-90 transition-opacity"
            >
              <CampusPlan highlight={room.buildingLetter} interactive={false} showLegend={false} />
            </a>
          </div>
        )}
      </aside>
    </div>
  </section>

  <TicketCta
    title="Cette session vous intéresse ?"
    description="L'entrée est libre et gratuite, mais l'inscription nous aide à préparer au mieux votre venue."
  />
</BaseLayout>

<script>
  // ── Partage ──
  const shareBtn = document.getElementById('share-talk');
  const shareLabel = shareBtn?.querySelector('[data-share-label]');
  const shareStatus = document.getElementById('share-status');

  /** navigator.clipboard needs a secure context; the textarea works everywhere else. */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(field);
      return ok;
    }
  }

  let labelTimer: ReturnType<typeof setTimeout>;

  shareBtn?.addEventListener('click', async () => {
    const url = shareBtn.dataset.url || location.href;
    const title = shareBtn.dataset.title || document.title;

    // Native share sheet where there is one (mobile, Safari); clipboard elsewhere.
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        return;
      } catch (err) {
        if ((err as Error)?.name === 'AbortError') return;
      }
    }

    const copied = await copyText(url);
    const message = copied ? 'Lien copié !' : 'Copie impossible';
    if (shareStatus) shareStatus.textContent = message;
    if (shareLabel) shareLabel.textContent = message;
    clearTimeout(labelTimer);
    labelTimer = setTimeout(() => {
      if (shareStatus) shareStatus.textContent = '';
      if (shareLabel) shareLabel.textContent = 'Partager';
    }, 2500);
  });

  // ── Favori (même stockage que /programme) ──
  const favBtn = document.getElementById('fav-talk');
  const favLabel = favBtn?.querySelector('[data-fav-label]');
  const code = favBtn?.dataset.code;
  const STORAGE_KEY = `cdl-favorites-${favBtn?.dataset.eventSlug ?? ''}`;

  function readFavorites(): Set<string> {
    try {
      return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));
    } catch {
      return new Set();
    }
  }

  function syncFav() {
    if (!favBtn || !code) return;
    const active = readFavorites().has(code);
    favBtn.setAttribute('aria-pressed', String(active));
    favBtn.querySelector('.fav-off')?.classList.toggle('hidden', active);
    favBtn.querySelector('.fav-on')?.classList.toggle('hidden', !active);
    favBtn.classList.toggle('border-cdl-orange/40', active);
    favBtn.classList.toggle('text-cdl-orange', active);
    if (favLabel) favLabel.textContent = active ? 'Dans mes favoris' : 'Ajouter à mes favoris';
  }

  favBtn?.addEventListener('click', () => {
    if (!code) return;
    const favs = readFavorites();
    if (favs.has(code)) favs.delete(code);
    else favs.add(code);
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favs]));
    syncFav();
  });

  syncFav();
</script>
