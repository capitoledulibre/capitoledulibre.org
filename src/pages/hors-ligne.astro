---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Served by the service worker (src/pwa/sw.js) for a page that is neither
 * reachable nor cached. Points at what the worker precaches, so every link
 * here works offline.
 */
const available = [
  { label: 'Programme', href: '/programme/' },
  { label: 'Plan & accès', href: '/lieu/' },
  { label: 'Se restaurer', href: '/se-restaurer/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Accueil', href: '/' },
];
---

<BaseLayout title="Hors connexion" noindex>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-cdl-orange/10 mb-6">
        <svg class="h-8 w-8 text-cdl-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M8.5 16.5a5 5 0 017 0M5 13a10 10 0 015.17-2.8M19 13a10 10 0 00-2.5-1.8M2 9.5a15 15 0 014.3-2.6M22 9.5A15 15 0 0011 5.05M12 20h.01" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-cdl-blue mb-4">
        Vous êtes hors connexion
      </h1>
      <p class="text-cdl-gray mb-10">
        Cette page n'a pas été enregistrée sur votre appareil. Le programme, le plan et
        les infos pratiques restent consultables sans réseau :
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        {available.map((page) => (
          <a
            href={page.href}
            class="px-4 py-2 text-sm font-medium text-cdl-gray border border-cdl-gray-light rounded-lg hover:border-cdl-orange/30 hover:text-cdl-orange transition-colors bg-white dark:bg-gray-800"
          >
            {page.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
