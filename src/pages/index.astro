---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CfpBanner from '../components/home/CfpBanner.astro';
import WhyAttendSection from '../components/home/WhyAttendSection.astro';
import HighlightsSection from '../components/home/HighlightsSection.astro';
import ParcoursSection from '../components/home/ParcoursSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import TimelineSection from '../components/home/TimelineSection.astro';
import GallerySection from '../components/home/GallerySection.astro';
import VideoSection from '../components/home/VideoSection.astro';
import PartnersPreview from '../components/home/PartnersPreview.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { config } from '../config';
import { getCollection } from 'astro:content';
import { eventNode } from '../lib/jsonld';

const partners = await getCollection('partners');

// "14 & 15 novembre 2026" would repeat the year already in the title.
const datesWithoutYear = config.edition.displayDates
  .replace(String(config.edition.year), '')
  .trim();
const homeTitle = `Capitole du Libre ${config.edition.year} — ${datesWithoutYear}, Toulouse`;

// The partner list doubles as the edition's sponsor list in structured data.
const sponsors = partners
  .map((partner) => ({ name: partner.data.name, url: partner.data.url }))
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
---

<BaseLayout
  title="Accueil"
  fullTitle={homeTitle}
>
  <JsonLd slot="head" data={eventNode({ sponsors })} />

  <!-- 1. Impact immédiat (stats intégrées au hero) -->
  <HeroSection />
  <CfpBanner />

  <!-- 2. Storytelling : pourquoi venir -->
  <WhyAttendSection />

  <!-- 4. Concret : ce qui vous attend -->
  <HighlightsSection />

  <!-- 5. Se projeter : c'est pour qui ? -->
  <ParcoursSection />

  <!-- 6. Preuve sociale -->
  <TestimonialsSection />

  <!-- 7. Immersion : une journée type -->
  <TimelineSection />

  <!-- 8. Ambiance visuelle -->
  <GallerySection />
  <VideoSection />

  <!-- 9. Écosystème -->
  <PartnersPreview />

  <!-- 10. Appel à l'action final -->
  <CtaSection />
</BaseLayout>
